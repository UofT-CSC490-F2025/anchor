# Development Environment Configuration
# Copy this to .env.local and modify as needed

# API Configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api
EXPO_PUBLIC_ENABLE_MOCKS=true

# Development Settings
EXPO_PUBLIC_DEV_MODE=true
EXPO_PUBLIC_LOG_LEVEL=debug

# Backend Status Indicators (for developers)
# Set to 'false' to use real API for specific endpoints
EXPO_PUBLIC_MOCK_AUTH=true
EXPO_PUBLIC_MOCK_CONTENT_ANALYSIS=false
EXPO_PUBLIC_MOCK_USER_MANAGEMENT=true
EXPO_PUBLIC_MOCK_TIKTOK_INTEGRATION=true